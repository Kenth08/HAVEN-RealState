# Copy to .env.local for local development. On Vercel, add the same names under
# Project → Settings → Environment Variables.

# Web3Forms access key (public by design): https://web3forms.com
VITE_WEB3FORMS_KEY=

# Public address of the site, used for canonical URLs, social previews and the
# sitemap. Defaults to https://haven-realstate.vercel.app when empty.
VITE_SITE_URL=
